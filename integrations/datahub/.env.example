# Schema-inspection role only: see README.md. Never use DATABASE_URL/app credentials.
CIVICLOOP_PG_HOST_PORT=localhost:15432
CIVICLOOP_PG_DATABASE=civicloop_metadata_dev
CIVICLOOP_PG_USER=civicloop_catalog
CIVICLOOP_PG_PASSWORD=replace-with-local-password
CIVICLOOP_PG_SSLMODE=disable
# Stable identifiers; changing them creates different catalog assets.
DATAHUB_ENV=DEV
DATAHUB_GMS_URL=http://localhost:18080
DATAHUB_GMS_TOKEN=replace-with-local-ingestion-token
